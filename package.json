{
  "name": "openapi-spec-simplifier",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm test && npm run build && npm run test:e2e",
    "format": "prettier --write src scripts tests index.html README.md *.config.ts *.json .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests index.html README.md *.config.ts *.json .github/workflows/*.yml",
    "benchmark": "node scripts/benchmark.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
